# Environment variables for the root-level data scripts
# (enrich_*.js, import_to_supabase.js, generate_sql_import.js, ...)
#
# Copy this file to .env and fill in your real values.
# Get credentials from: Supabase Dashboard → Settings → API

# Supabase project URL
SUPABASE_URL=https://your-project.supabase.co

# Prefer the service_role key for write scripts (full access — keep private!)
SUPABASE_SERVICE_KEY=your_service_role_key

# Anon key (read-only access; fine for read-only scripts)
SUPABASE_ANON_KEY=your_anon_key

# Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here